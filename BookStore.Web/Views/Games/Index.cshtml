@model IEnumerable<BookStore.Domain.PartnerDomain.Game>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.GameImage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GameTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GameDesc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateReleased)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Developer.DevName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            <tr>
                <td>
                    <img src="@item.GameImage" height="70px" width="70px"/>
                </td>
            <td style="vertical-align: middle">
                @Html.DisplayFor(modelItem => item.GameTitle)
            </td>
                <td style="vertical-align: middle">
                @Html.DisplayFor(modelItem => item.GameDesc)
            </td>
                <td style="vertical-align: middle">
                @Html.DisplayFor(modelItem => item.DateReleased)
            </td>
            
                <td style="vertical-align: middle">
                @Html.DisplayFor(modelItem => item.Rating)
            </td>
                <td style="vertical-align: middle">
                @Html.DisplayFor(modelItem => item.Price)
            </td>

                <td style="vertical-align: middle">
                @Html.DisplayFor(modelItem => item.Developer.DevName)
            </td> 
                <td style="vertical-align: middle">
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> <br />
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> <br />
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
